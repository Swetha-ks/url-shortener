# Copy this file to .env and fill in your own values.
# NEVER put real secrets in this example file.

# Database: SQLite for quick local runs, PostgreSQL for production
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/shortener

# Leave empty to use an in-memory cache (fine for local dev).
# Example with Redis: redis://localhost:6379/0
REDIS_URL=

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public URL used when building short links
BASE_URL=http://localhost:8000

# Tuning
CACHE_TTL_SECONDS=3600
CODE_LENGTH=7
CREATE_LIMIT_PER_MINUTE=20
LOGIN_LIMIT_PER_MINUTE=10
